&НаСервере
Функция ПолучитьДанныеКонтактаНаСервере(СсылкаНаКлиента)
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   КонтактныеЛица.Адрес КАК Адрес,
    |   КонтактныеЛица.Фамилия + "" "" + КонтактныеЛица.Имя КАК ФИО
    |ИЗ
    |   Справочник.КонтактныеЛица КАК КонтактныеЛица
    |ГДЕ
    |   КонтактныеЛица.Клиент = &Клиент
    |   И КонтактныеЛица.Фамилия <> """"";
    
    Запрос.УстановитьПараметр("Клиент", СсылкаНаКлиента);
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Если Выборка.Следующий() Тогда
        СтруктураДанных = Новый Структура;
        СтруктураДанных.Вставить("Адрес", Выборка.Адрес);
        СтруктураДанных.Вставить("ФИО", Выборка.ФИО);
        Возврат СтруктураДанных;
    КонецЕсли;
    
    Возврат Неопределено;
КонецФункции

&НаСервере
Функция ПолучитьЦенуНаДату(Номенклатура, ДатаДокумента)
    Если Номенклатура = Неопределено Тогда
        Возврат 0;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Цены.Цена КАК Цена
    |ИЗ
    |   РегистрСведений.Цены КАК Цены
    |ГДЕ
    |   Цены.Номенклатура = &Номенклатура
    |   И Цены.Период <= &ДатаДокумента
    |УПОРЯДОЧИТЬ ПО
    |   Цены.Период УБЫВ";
    
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Цена;
    КонецЕсли;
    
    Возврат 0;
КонецФункции

&НаСервере
Функция ПолучитьСтавкуНалогаНаСервере(Номенклатура)
    Если Номенклатура = Неопределено Тогда
        Возврат 0.2;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Номенклатура.Налог КАК Налог
    |ИЗ
    |   Справочник.Продукция КАК Номенклатура
    |ГДЕ
    |   Номенклатура.Ссылка = &Номенклатура
    |
    |ОБЪЕДИНИТЬ ВСЕ
    |
    |ВЫБРАТЬ ПЕРВЫЕ 1
    |   Аксессуары.Налог
    |ИЗ
    |   Справочник.Аксессуары КАК Аксессуары
    |ГДЕ
    |   Аксессуары.Ссылка = &Номенклатура";
    
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Если Выборка.Следующий() Тогда
        Если Выборка.Налог > 0 Тогда
            Возврат Выборка.Налог;
        КонецЕсли;
    КонецЕсли;
    
    Возврат 0.2;
КонецФункции

&НаСервере
Процедура РассчитатьИтогДокументаНаСервере()
    ИтогСНДС = 0;
    Для каждого Строка Из Объект.Спецификация Цикл
        ИтогСНДС = ИтогСНДС + Строка.ЦенаСНДС;
    КонецЦикла;
    Объект.СуммаДокумента = ИтогСНДС;
    Объект.ИтогЦенаСНДС = ИтогСНДС;
КонецПроцедуры

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
    Если Объект.Клиент = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ДанныеКонтакта = ПолучитьДанныеКонтактаНаСервере(Объект.Клиент);
    
    Если ДанныеКонтакта <> Неопределено Тогда
        Объект.АдресДоставки = ДанныеКонтакта.Адрес;
        Объект.Получатель    = ДанныеКонтакта.ФИО;
    Иначе
        Объект.АдресДоставки = "";
        Объект.Получатель    = "";
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СпецификацияНоменклатураПриИзменении(Элемент)
    ТекущиеДанные = Элементы.Спецификация.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Если ТекущиеДанные.Номенклатура = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Получаем цену без НДС из регистра
    ТекущиеДанные.Цена = ПолучитьЦенуНаДату(ТекущиеДанные.Номенклатура, Объект.Дата);
    
    // Получаем ставку налога
    Ставка = ПолучитьСтавкуНалогаНаСервере(ТекущиеДанные.Номенклатура);
    // Сумма строки с НДС (ЦенаСНДС теперь хранит сумму строки)
    ТекущиеДанные.ЦенаСНДС = ТекущиеДанные.Количество * ТекущиеДанные.Цена * (1 + Ставка);
    // Сумма строки без НДС
    ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ТекущиеДанные.Цена;
    
    РассчитатьИтогДокументаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СпецификацияКоличествоПриИзменении(Элемент)
    ТекущиеДанные = Элементы.Спецификация.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Получаем ставку налога
    Ставка = ПолучитьСтавкуНалогаНаСервере(ТекущиеДанные.Номенклатура);
    // Пересчитываем сумму строки с НДС
    ТекущиеДанные.ЦенаСНДС = ТекущиеДанные.Количество * ТекущиеДанные.Цена * (1 + Ставка);
    // Пересчитываем сумму строки без НДС
    ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ТекущиеДанные.Цена;
    
    РассчитатьИтогДокументаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИтогДокумента()
    РассчитатьИтогДокументаНаСервере();
КонецПроцедуры