Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    
    // 0. Для нового договора проверяем дату и галочку
    Если ЭтотОбъект.Ссылка.Пустая() Тогда
        Если ДатаПодписания = '00010101' Тогда
            Отказ = Истина;
            Сообщить("Заполните дату подписания договора!");
            Возврат;
        КонецЕсли;
        
        Если Не Подписан Тогда
            Отказ = Истина;
            Сообщить("Договор должен быть подписан!");
            Возврат;
        КонецЕсли;
        
        // Для нового договора выходим, дальше не проверяем
        Возврат;
    КонецЕсли;
    
    // 1. Запрет изменений уже подписанного договора
    // Проверяем, был ли договор подписан до записи
    СтарыйОбъект = ЭтотОбъект.Ссылка.ПолучитьОбъект();
    Если СтарыйОбъект.Подписан Тогда
        // Если меняют дату или галочку у подписанного договора
        Если СтарыйОбъект.ДатаПодписания <> ДатаПодписания 
            Или СтарыйОбъект.Подписан <> Подписан Тогда
            Отказ = Истина;
            Сообщить("Подписанный договор нельзя изменять!");
            Возврат;
        КонецЕсли;
    КонецЕсли;
    
    // 2. Запрет создания второго договора по одному заказу
    Если ЗаказОснование = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Договор.Ссылка
    |ИЗ
    |   Документ.Договор КАК Договор
    |ГДЕ
    |   Договор.ЗаказОснование = &Заказ
    |   И Договор.Ссылка <> &ТекущийДоговор";
    
    Запрос.УстановитьПараметр("Заказ", ЗаказОснование);
    Запрос.УстановитьПараметр("ТекущийДоговор", ЭтотОбъект.Ссылка);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    Если Выборка.Следующий() Тогда
        Отказ = Истина;
        Сообщить("По этому заказу уже существует договор!");
    КонецЕсли;
    
КонецПроцедуры