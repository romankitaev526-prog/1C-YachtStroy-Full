&НаКлиенте
Процедура Сформировать(Команда)
    СформироватьВНовомОкне();
КонецПроцедуры

&НаСервере
Функция ПолучитьОтчёт()
    Запрос = Новый Запрос;
    
    ЗапросПроверка = Новый Запрос;
    ЗапросПроверка.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Заказ.Ссылка ИЗ Документ.Заказ КАК Заказ ГДЕ Заказ.Проведен = ИСТИНА";
    Если ЗапросПроверка.Выполнить().Пустой() Тогда
        Таб = Новый ТабличныйДокумент;
        Таб.Область(1, 1).Текст = "Нет проведённых заказов.";
        Возврат Таб;
    КонецЕсли;
    
    // Частые клиенты
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   Заказ.Клиент КАК Клиент,
    |   КОЛИЧЕСТВО(Заказ.Ссылка) КАК КоличествоЗаказов
    |ИЗ
    |   Документ.Заказ КАК Заказ
    |ГДЕ
    |   Заказ.Проведен = ИСТИНА
    |СГРУППИРОВАТЬ ПО
    |   Заказ.Клиент
    |УПОРЯДОЧИТЬ ПО
    |   КОЛИЧЕСТВО(Заказ.Ссылка) УБЫВ";
    
    РезЗапроса = Запрос.Выполнить();
    Выборка = РезЗапроса.Выбрать();
    
    Таб = Новый ТабличныйДокумент;
    Таб.Область(1, 1).Текст = "Клиент";
    Таб.Область(1, 2).Текст = "Количество заказов";
    
    Стр = 2;
    Пока Выборка.Следующий() Цикл
        Таб.Область(Стр, 1).Текст = Выборка.Клиент;
        Таб.Область(Стр, 2).Текст = Выборка.КоличествоЗаказов;
        Стр = Стр + 1;
    КонецЦикла;
    
    // Разделитель
    Стр = Стр + 1;
    Таб.Область(Стр, 1).Текст = "";
    
    Стр = Стр + 1;
    Таб.Область(Стр, 1).Текст = "Самые дорогие заказы:";
    
    Стр = Стр + 1;
    Таб.Область(Стр, 1).Текст = "Заказ";
    Таб.Область(Стр, 2).Текст = "Клиент";
    Таб.Область(Стр, 3).Текст = "Сумма";
    
    // Дорогие заказы
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   Заказ.Ссылка КАК Заказ,
    |   Заказ.Клиент КАК Клиент,
    |   Заказ.СуммаДокумента КАК Сумма
    |ИЗ
    |   Документ.Заказ КАК Заказ
    |ГДЕ
    |   Заказ.Проведен = ИСТИНА
    |УПОРЯДОЧИТЬ ПО
    |   Заказ.СуммаДокумента УБЫВ";
    
    РезЗапроса2 = Запрос.Выполнить();
    Выборка2 = РезЗапроса2.Выбрать();
    
    Стр = Стр + 1;
    Пока Выборка2.Следующий() Цикл
        Таб.Область(Стр, 1).Текст = Выборка2.Заказ;
        Таб.Область(Стр, 2).Текст = Выборка2.Клиент;
        Таб.Область(Стр, 3).Текст = Выборка2.Сумма;
        Стр = Стр + 1;
    КонецЦикла;
    
    Возврат Таб;
КонецФункции

&НаКлиенте
Процедура СформироватьВНовомОкне()
    Таб = ПолучитьОтчёт();
    Таб.Показать("Отчёты по заказам");
КонецПроцедуры